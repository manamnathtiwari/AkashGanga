# AkashGanga backend configuration
# Copy to .env and fill in values.

# Comma-separated CORS origins (Flutter web dev server, etc.)
AKASHGANGA_CORS_ORIGINS=http://localhost:3000,http://localhost:8080

# JWT signing secret. CHANGE THIS in production (use a long random string).
AKASHGANGA_JWT_SECRET=dev-insecure-change-me-0000000000000000
AKASHGANGA_JWT_EXPIRE_MINUTES=10080

# Database. Default is local SQLite (zero-setup, free).
# For Postgres (e.g. free Neon/Supabase tier) use:
#   postgresql+asyncpg://user:pass@host:5432/dbname
AKASHGANGA_DATABASE_URL=sqlite+aiosqlite:///./akashganga.db

# Where uploaded images are stored locally (dev). Swap for S3 later.
AKASHGANGA_UPLOAD_DIR=./uploads

# nova.astrometry.net API (FREE). Get a key at https://nova.astrometry.net (My Profile).
# Leave the key blank to run the backend in "mock solver" mode (no real solving).
AKASHGANGA_SOLVER_BACKEND=astrometry_net
AKASHGANGA_ASTROMETRY_API_KEY=
AKASHGANGA_ASTROMETRY_BASE_URL=https://nova.astrometry.net/api
